# Django
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL via Docker)
DB_NAME=islalearn
DB_USER=islalearn
DB_PASSWORD=islalearn_dev
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS (Next.js dev origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Whereby (Broadcasts)
WHEREBY_API_KEY=
WHEREBY_API_URL=https://api.whereby.dev/v1/meetings

# Channels (Messages WebSocket). dev.py falls back to in-memory if empty.
REDIS_URL=redis://127.0.0.1:6379/0

# Railway Bucket credentials (injected by "Add to Service" > Django)
AWS_ACCESS_KEY_ID=your_railway_bucket_access_key
AWS_SECRET_ACCESS_KEY=your_railway_bucket_secret_key
AWS_STORAGE_BUCKET_NAME=islalearn-media
AWS_S3_ENDPOINT_URL=https://storage.railway.app
AWS_S3_REGION_NAME=auto

# Public redirect service (deploy the "Public Bucket URLs" template)
MEDIA_REDIRECT_BASE=https://your-public-bucket-urls.up.railway.app